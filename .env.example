# Copy this file to .env and replace the values for your installation.
# Never commit .env or place real secrets in this template.

# Active MQTT broker configuration
MQTT_HOSTNAME=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# Bike namespace used by the dashboard and driver services.
# Use a different value for each bike, for example 000001 or 000002.
DEVICE_ID=000001

# Hardware-specific KICKR address used by scripts/start_kickr.sh.
# Replace this with the Bluetooth MAC address of the installed trainer.
KICKR_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# Dashboard compatibility aliases.
# Leave these blank when the primary MQTT_* and DEVICE_ID variables above are set. They are retained because older drivers and deployments use them.
MQTT_HOST=
MQTT_USER=
MQTT_PASS=
BIKEID=


